<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1B3A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOULSYNC STATISTICS"
            android:textColor="#00D4FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your behavioral pattern analysis"
            android:textColor="#8899AA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/currentStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="مستقر"
            android:textColor="#00D4FF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/currentStateDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stable - Your baseline is within normal range"
            android:textColor="#8899AA"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/stablePercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Stable: 0%"
            android:textColor="#00D4FF"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/inactivePercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Inactive: 0%"
            android:textColor="#8899AA"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/moderatePercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Moderate: 0%"
            android:textColor="#FFB300"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/highPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="High: 0%"
            android:textColor="#FF4444"
            android:textSize="16sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
